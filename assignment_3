package employee;
import java.util.*;

class Emp{
	protected double salary;
	protected String name;
	Emp(String name,double salary) throws Exception{
		if(salary<=0) {
			throw new Exception("Salary can not be negative or zero");
		}
		if(name == null || name == "") {
			throw new Exception("Name not entered");
		}
		this.salary = salary;
		this.name = name;
	}
	void calculateSal() {
		System.out.println("Salary is:"+this.salary);
	}
	void display() {
		System.out.println("Name:"+this.name);        
		
		System.out.println("Salary:"+this.salary);
	}
}

class Manager extends Emp{
	private double bonus;
	public Manager(String name, double salary, double bonus) throws Exception{
		super(name,salary);
		if(bonus<=0) {
			throw new Exception("Bonus can not be nagative or zero");
		}
		this.bonus = bonus;
	}
	
	@Override
	void calculateSal() {
		double sal = this.salary + this.bonus;
		System.out.println("Salary with bonus:"+sal);
	}
	
}

class TeamLeader extends Emp{
	private double increment;
	
	public TeamLeader(String name, double salary, double increment) throws Exception{
		super(name, salary);
		if(increment<=0) {
			throw new Exception("Increment can not be negative or zero");
		}
		this.increment = increment;
	}

	@Override
	void calculateSal() {
		double TotalSal = this.salary + this.increment;
		System.out.println("Updated Salary:"+TotalSal);
	}
	
}

